// Copy to config.h and fill in. config.h is gitignored.
#pragma once

#define WIFI_SSID      "your-ssid"
#define WIFI_PASSWORD  "your-password"

// NOTE trailing slash — Next.js `trailingSlash: true` issues a 308 without it.
#define ROLL_CALL_URL       "http://10.0.0.75:3000/employee-presence/api/roll-call/"
#define INCIDENTS_POST_URL  "http://10.0.0.75:3000/employee-presence/api/roll-call/incidents/"

// Identifier recorded against every incident row this device posts.
// Hand-assign per physical unit (e.g. "papers3-muster-bay-1").
#define DEVICE_ID  "papers3-roll-call-1"

// Auto-refresh interval while IDLE. 0 = manual only.
#define AUTO_REFRESH_MIN  5

// NTP server (uses UDP/123). pool.ntp.org works on most LANs.
#define NTP_SERVER  "pool.ntp.org"
